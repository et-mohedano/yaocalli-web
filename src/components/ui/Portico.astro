---
// Pórtico de cierre: una sola acción principal por página, tal como pide
// 2_Arquitectura_y_Wireframes_Yaocalli.html en cada wireframe.
import Button from './Button.astro';
import { linkWhatsappGeneral } from '../../utils/contacto';

interface Props {
  titulo: string;
  texto?: string;
  cta: { etiqueta: string; href: string };
  conWhatsapp?: boolean;
  class?: string;
}
const { titulo, texto, cta, conWhatsapp = false, class: className = '' } = Astro.props;
---

<section class={`graticule bg-obsidiana text-cal py-14 ${className}`}>
  <div class="max-w-3xl mx-auto px-5 sm:px-8 text-center">
    <h2 class="font-serif font-bold text-2xl sm:text-3xl">{titulo}</h2>
    {texto && <p class="mt-3 text-g-400 font-sans">{texto}</p>}
    <div class="mt-7 flex flex-col sm:flex-row gap-3 justify-center">
      <Button href={cta.href}>{cta.etiqueta}</Button>
      {conWhatsapp && (
        <Button href={linkWhatsappGeneral()} variante="outline" external>
          Escribir por WhatsApp
        </Button>
      )}
    </div>
  </div>
</section>
