---
interface Props {
  items: { pregunta: string; respuesta: string }[];
  class?: string;
}
const { items, class: className = '' } = Astro.props;
---

<div class={`divide-y divide-g-300 border-t border-b border-g-300 ${className}`}>
  {items.map((item, i) => (
    <details class="group py-1" open={i === 0}>
      <summary class="flex items-center justify-between gap-4 py-3 cursor-pointer font-sans font-medium text-obsidiana list-none min-h-11">
        {item.pregunta}
        <svg class="shrink-0 transition-transform group-open:rotate-45" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 5v14M5 12h14" stroke-linecap="round"></path>
        </svg>
      </summary>
      <p class="pb-4 pr-8 text-g-700 font-sans text-[17px] leading-relaxed">{item.respuesta}</p>
    </details>
  ))}
</div>
