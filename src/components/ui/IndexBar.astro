---
// Barra de índice: elemento gráfico de marca (manual de identidad, sección 7).
// Representa un valor dentro de un rango de tramos en jade, del lavado al profundo.
// Los cuatro tramos por defecto usan clases de Tailwind fijas (más nítido en los
// dos usos existentes de 4 niveles); con un número distinto de etiquetas se
// interpola el color en línea entre jade-wash y jade-deep — necesario porque el
// JIT de Tailwind no genera utilidades a partir de clases construidas dinámicamente.
interface Props {
  etiquetas?: string[];
  activo?: number;
  class?: string;
}
const { etiquetas = ['Bajo', 'Medio', 'Alto', 'Muy alto'], activo, class: className = '' } = Astro.props;

const TRAMOS_DEFECTO_4 = [
  { bg: 'bg-jade-wash', text: 'text-jade-deep' },
  { bg: 'bg-jade-pale', text: 'text-obsidiana' },
  { bg: 'bg-jade', text: 'text-jade-wash' },
  { bg: 'bg-jade-deep', text: 'text-jade-wash' },
];

function hexAMezcla(hexA: string, hexB: string, t: number): string {
  const a = [parseInt(hexA.slice(1, 3), 16), parseInt(hexA.slice(3, 5), 16), parseInt(hexA.slice(5, 7), 16)];
  const b = [parseInt(hexB.slice(1, 3), 16), parseInt(hexB.slice(3, 5), 16), parseInt(hexB.slice(5, 7), 16)];
  const mezcla = a.map((canal, i) => Math.round(canal + (b[i] - canal) * t));
  return `#${mezcla.map((c) => c.toString(16).padStart(2, '0')).join('')}`;
}

const tramos =
  etiquetas.length === 4
    ? TRAMOS_DEFECTO_4
    : etiquetas.map((_, i) => {
        const t = etiquetas.length === 1 ? 0 : i / (etiquetas.length - 1);
        return { color: hexAMezcla('#E8EFEB', '#2C4C3F', t), oscuro: t > 0.55 };
      });
---

<div
  class={`flex h-9 rounded-sm overflow-hidden font-sans text-xs max-w-md border border-jade/30 divide-x divide-jade/30 ${className}`}
  role="img"
  aria-label={`Escala: ${etiquetas.join(', ')}`}
>
  {tramos.map((t, i) => (
    <div
      class:list={[
        'flex-1 flex items-center justify-center relative',
        'bg' in t ? [t.bg, t.text] : t.oscuro ? 'text-jade-wash' : 'text-obsidiana',
        activo === i && 'ring-2 ring-inset ring-obsidiana font-medium',
      ]}
      style={'color' in t ? `background-color:${t.color}` : undefined}
    >
      {etiquetas[i]}
    </div>
  ))}
</div>
