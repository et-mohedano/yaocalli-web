---
// Mapa de cobertura: los 84 municipios de Hidalgo, con geometría real y un
// hover que muestra población por sexo y una mini ficha técnica del censo.
//
// Los polígonos y el censo cruzado vienen de fuentes oficiales de INEGI
// (límites municipales + Censo de Población y Vivienda 2020), procesados por
// scripts/build-hidalgo-map.mjs — ver ese script para regenerar
// src/data/hidalgo-municipios.json si cambia alguna fuente.
import mapa from '../../data/hidalgo-municipios.json';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const TOTAL = mapa.municipios.length;
// Cuatro puntos destacados, elegidos por posición en la lista (no por identidad
// real) solo para dar variedad visual — no corresponden a ningún caso concreto.
const destacadosIdx = new Set([Math.round(TOTAL * 0.12), Math.round(TOTAL * 0.4), Math.round(TOTAL * 0.63), Math.round(TOTAL * 0.86)]);
---

<div class={`hidalgo-map relative ${className}`} id="hidalgo-map-datos" data-fuente={mapa.fuenteCenso}>
  <svg viewBox={mapa.viewBox} role="img" aria-label="Cobertura de 84 municipios en Hidalgo, con censo de población al pasar el cursor" class="w-full h-auto overflow-visible">
    <g class="map-polys">
      {mapa.municipios.map((m, i) => (
        <path
          d={m.path}
          class="map-poly"
          data-i={i}
          style={`--delay:${(i % 42) * 22}ms; --len:${m.len}`}
        ></path>
      ))}
    </g>
    <g class="map-dots">
      {mapa.municipios.map((m, i) => (
        <circle
          cx={m.cx}
          cy={m.cy}
          r={destacadosIdx.has(i) ? 6.5 : 4}
          data-i={i}
          class:list={['map-dot', destacadosIdx.has(i) && 'map-dot-destacado']}
          style={`--delay:${600 + (i % 30) * 35}ms`}
        ></circle>
      ))}
    </g>
  </svg>

  <div id="map-tooltip" class="map-tooltip font-sans" aria-hidden="true">
    <p class="mt-nombre font-serif font-bold text-obsidiana"></p>
    <p class="mt-pobtot"><span class="mt-pobtot-num"></span> <span class="text-g-600 text-xs">habitantes</span></p>
    <div class="mt-barras">
      <div class="mt-fila">
        <span class="mt-etq">Mujeres</span>
        <div class="mt-track"><div class="mt-fill mt-fill-fem"></div></div>
        <span class="mt-val mt-val-fem"></span>
      </div>
      <div class="mt-fila">
        <span class="mt-etq">Hombres</span>
        <div class="mt-track"><div class="mt-fill mt-fill-mas"></div></div>
        <span class="mt-val mt-val-mas"></span>
      </div>
    </div>
    <dl class="mt-ficha">
      <div><dt>0–14 años</dt><dd class="mt-p0"></dd></div>
      <div><dt>15–64 años</dt><dd class="mt-p1"></dd></div>
      <div><dt>65 y más</dt><dd class="mt-p2"></dd></div>
      <div><dt>Escolaridad prom.</dt><dd class="mt-esc"></dd></div>
      <div><dt>Viviendas habitadas</dt><dd class="mt-viv"></dd></div>
    </dl>
    <p class="mt-fuente"></p>
  </div>

  <p class="text-center font-sans text-xs text-g-500 mt-1">Cobertura verificada · 84 municipios · pase el cursor para ver el censo</p>
</div>

<style>
  .map-poly {
    fill: rgba(127, 165, 147, 0.07);
    stroke: #7fa593;
    stroke-width: 1.4;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: var(--len);
    stroke-dashoffset: var(--len);
    opacity: 0;
    cursor: pointer;
    transition: opacity 0.4s ease var(--delay), stroke-dashoffset 1.1s cubic-bezier(0.22, 1, 0.36, 1) var(--delay), fill 0.2s ease,
      stroke 0.2s ease, stroke-width 0.2s ease;
  }
  .hidalgo-map.in-view .map-poly {
    opacity: 1;
    stroke-dashoffset: 0;
  }
  .map-poly:hover,
  .map-poly.map-poly-activo {
    fill: rgba(140, 74, 47, 0.22);
    stroke: #c98f72;
    stroke-width: 2.2;
  }

  .map-dot {
    fill: #7fa593;
    opacity: 0;
    transform: scale(0.3);
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity 0.5s ease var(--delay), transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) var(--delay);
    pointer-events: none;
  }
  .map-dot-destacado {
    fill: #8c4a2f;
  }
  .hidalgo-map.in-view .map-dot {
    opacity: 1;
    transform: scale(1);
  }
  .map-dot.map-dot-activo {
    transform: scale(1.6);
    fill: #c98f72;
  }
  .map-dot-destacado {
    animation: dot-pulse 2.6s ease-in-out infinite;
    animation-delay: calc(var(--delay) + 0.8s);
  }
  @keyframes dot-pulse {
    0%,
    100% {
      filter: drop-shadow(0 0 0 rgba(140, 74, 47, 0));
    }
    50% {
      filter: drop-shadow(0 0 4px rgba(201, 143, 114, 0.9));
    }
  }

  /* Ficha flotante del censo */
  .map-tooltip {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 20;
    width: 232px;
    background: #efe9de;
    border-top: 2px solid #8c4a2f;
    border-radius: 2px;
    padding: 12px 14px 11px;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.15s ease, transform 0.15s ease;
    pointer-events: none;
  }
  .map-tooltip.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .mt-nombre {
    font-size: 15px;
    line-height: 1.2;
    margin: 0 0 2px;
  }
  .mt-pobtot {
    margin: 0 0 8px;
  }
  .mt-pobtot-num {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 20px;
    color: #2c4c3f;
    font-variant-numeric: tabular-nums;
  }
  .mt-barras {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 9px;
  }
  .mt-fila {
    display: grid;
    grid-template-columns: 46px 1fr 34px;
    align-items: center;
    gap: 6px;
    font-size: 10.5px;
    color: #4d4841;
  }
  .mt-track {
    height: 6px;
    background: #d2ccbf;
    border-radius: 2px;
    overflow: hidden;
  }
  .mt-fill {
    height: 100%;
    border-radius: 2px;
  }
  .mt-fill-fem {
    background: #8c4a2f;
  }
  .mt-fill-mas {
    background: #3f6b5a;
  }
  .mt-val {
    text-align: right;
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    color: #14110f;
  }
  .mt-ficha {
    margin: 0 0 8px;
    padding-top: 7px;
    border-top: 1px solid #d2ccbf;
    display: grid;
    gap: 3px;
  }
  .mt-ficha div {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-size: 10.5px;
  }
  .mt-ficha dt {
    color: #6a645a;
  }
  .mt-ficha dd {
    margin: 0;
    font-weight: 500;
    color: #14110f;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .mt-fuente {
    margin: 0;
    font-size: 9.5px;
    color: #8a8377;
    line-height: 1.3;
  }

  @media (prefers-reduced-motion: reduce) {
    .map-poly {
      transition: opacity 0.2s ease, fill 0.2s ease, stroke 0.2s ease;
      opacity: 1;
      stroke-dashoffset: 0;
    }
    .map-dot {
      transition: none;
      opacity: 1;
      transform: none;
    }
    .map-dot-destacado {
      animation: none;
    }
  }
  @media (hover: none) {
    /* Sin puntero fino (táctil): el hover se reemplaza por toque, ver script. */
    .map-tooltip {
      width: min(232px, 78vw);
    }
  }
</style>

<script>
  import mapaCliente from '../../data/hidalgo-municipios.json';

  // Animación de entrada: dibuja los polígonos y aparece los puntos al hacer
  // scroll hasta el mapa. Sin esto, el mapa existe en el DOM pero se queda en
  // opacity:0 para siempre (el hover de abajo sigue funcionando igual, porque
  // los eventos de puntero no dependen de la opacidad).
  const mapasParaAnimar = document.querySelectorAll<HTMLElement>('.hidalgo-map:not(.in-view)');
  if ('IntersectionObserver' in window) {
    const observerEntrada = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            obs.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.2 }
    );
    mapasParaAnimar.forEach((m) => observerEntrada.observe(m));
  } else {
    mapasParaAnimar.forEach((m) => m.classList.add('in-view'));
  }

  const raizNullable = document.getElementById('hidalgo-map-datos');
  const tooltipNullable = document.getElementById('map-tooltip');
  if (raizNullable && tooltipNullable) {
    // Constantes locales no-anulables: TypeScript no propaga el chequeo de arriba
    // dentro de las funciones anidadas que se declaran más abajo.
    const raiz = raizNullable;
    const tooltip = tooltipNullable;
    const nfEntero = new Intl.NumberFormat('es-MX');
    const elNombre = tooltip.querySelector('.mt-nombre')!;
    const elPobtot = tooltip.querySelector('.mt-pobtot-num')!;
    const elFillFem = tooltip.querySelector('.mt-fill-fem') as HTMLElement;
    const elFillMas = tooltip.querySelector('.mt-fill-mas') as HTMLElement;
    const elValFem = tooltip.querySelector('.mt-val-fem')!;
    const elValMas = tooltip.querySelector('.mt-val-mas')!;
    const elP0 = tooltip.querySelector('.mt-p0')!;
    const elP1 = tooltip.querySelector('.mt-p1')!;
    const elP2 = tooltip.querySelector('.mt-p2')!;
    const elEsc = tooltip.querySelector('.mt-esc')!;
    const elViv = tooltip.querySelector('.mt-viv')!;
    const elFuente = tooltip.querySelector('.mt-fuente')!;
    const fuente = raiz.dataset.fuente ?? '';

    let activo: SVGPathElement | null = null;
    let activoDot: SVGCircleElement | null = null;

    function pct(parte: number | null, total: number | null): string {
      if (parte == null || !total) return '—';
      return `${Math.round((parte / total) * 100)}%`;
    }
    function formato(n: number | null): string {
      return n == null ? '—' : nfEntero.format(n);
    }

    function mostrar(i: number) {
      const m = mapaCliente.municipios[i];
      if (!m) return;
      elNombre.textContent = m.nombre;
      const c = m.censo;
      elPobtot.textContent = formato(c?.pobtot ?? null);
      const total = c?.pobtot ?? 0;
      const femPct = c && total ? (c.pobfem! / total) * 100 : 0;
      const masPct = c && total ? (c.pobmas! / total) * 100 : 0;
      elFillFem.style.width = `${femPct}%`;
      elFillMas.style.width = `${masPct}%`;
      elValFem.textContent = pct(c?.pobfem ?? null, c?.pobtot ?? null);
      elValMas.textContent = pct(c?.pobmas ?? null, c?.pobtot ?? null);
      elP0.textContent = formato(c?.pob0a14 ?? null);
      elP1.textContent = formato(c?.pob15a64 ?? null);
      elP2.textContent = formato(c?.pob65mas ?? null);
      elEsc.textContent = c?.graproes != null ? `${c.graproes} años` : '—';
      elViv.textContent = formato(c?.tvivhab ?? null);
      elFuente.textContent = fuente;
    }

    function posicionar(clientX: number, clientY: number) {
      const rect = raiz.getBoundingClientRect();
      const anchoTooltip = tooltip.offsetWidth || 232;
      let x = clientX - rect.left + 14;
      let y = clientY - rect.top + 14;
      if (x + anchoTooltip > rect.width) x = clientX - rect.left - anchoTooltip - 14;
      if (y + tooltip.offsetHeight > rect.height) y = Math.max(0, rect.height - tooltip.offsetHeight - 4);
      tooltip.style.left = `${x}px`;
      tooltip.style.top = `${y}px`;
    }

    function activar(path: SVGPathElement, clientX: number, clientY: number) {
      const i = Number(path.dataset.i);
      if (activo && activo !== path) activo.classList.remove('map-poly-activo');
      if (activoDot) activoDot.classList.remove('map-dot-activo');
      activo = path;
      activoDot = raiz.querySelector<SVGCircleElement>(`.map-dot[data-i="${i}"]`);
      activo.classList.add('map-poly-activo');
      activoDot?.classList.add('map-dot-activo');
      mostrar(i);
      posicionar(clientX, clientY);
      tooltip.classList.add('visible');
    }

    function desactivar() {
      activo?.classList.remove('map-poly-activo');
      activoDot?.classList.remove('map-dot-activo');
      activo = null;
      activoDot = null;
      tooltip.classList.remove('visible');
    }

    const puntoFino = matchMedia('(hover: hover) and (pointer: fine)').matches;

    raiz.querySelectorAll<SVGPathElement>('.map-poly').forEach((path) => {
      if (puntoFino) {
        path.addEventListener('pointerenter', (e) => activar(path, e.clientX, e.clientY));
        path.addEventListener('pointermove', (e) => posicionar(e.clientX, e.clientY));
        path.addEventListener('pointerleave', desactivar);
      } else {
        // Táctil: un toque activa/muestra; tocar fuera del mapa cierra.
        path.addEventListener('click', (e) => {
          e.stopPropagation();
          const evento = e as MouseEvent;
          if (activo === path) {
            desactivar();
          } else {
            activar(path, evento.clientX, evento.clientY);
          }
        });
      }
    });
    document.addEventListener('click', (e) => {
      if (!puntoFino && activo && !raiz.contains(e.target as Node)) desactivar();
    });
  }
</script>
