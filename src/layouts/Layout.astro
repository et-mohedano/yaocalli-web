---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppBar from '../components/layout/WhatsAppBar.astro';
import { jsonLdOrganizacion } from '../utils/seo';

interface Props {
  /** Hasta 60 caracteres, palabra clave al inicio. No se le agrega sufijo: cada página ya lo trae. */
  title: string;
  /** 140-160 caracteres. */
  description: string;
  /** Bloques JSON-LD adicionales específicos de la página (servicio, artículo, FAQ...). */
  jsonLd?: object[];
  ogImage?: string;
  articulo?: { publicado: string; modificado: string };
}

const { title, description, jsonLd = [], ogImage = '/images/marca/yaocalli-og.svg', articulo } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const bloquesJsonLd = [jsonLdOrganizacion(), ...jsonLd];
---

<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,400;0,500;0,700;1,400;1,500&family=Alegreya+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content={articulo ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="Yaocalli Consultoría y Estrategia" />
    {articulo && <meta property="article:published_time" content={articulo.publicado} />}
    {articulo && <meta property="article:modified_time" content={articulo.modificado} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    {bloquesJsonLd.map((bloque) => (
      <script type="application/ld+json" set:html={JSON.stringify(bloque)} is:inline />
    ))}
  </head>
  <body>
    <a href="#contenido" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-cal focus:text-obsidiana focus:px-4 focus:py-2">
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <WhatsAppBar />
  </body>
</html>
